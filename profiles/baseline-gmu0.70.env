# m-8 baseline profile — validated FP8 dual-Spark config (TASK-73 / TASK-73.01)
# Tracked source of truth for the "don't regress this" line.
# Secrets (HF_TOKEN etc.) are NOT in this file; they live in the gitignored .env only.
#
# Captured from the running deployment (docker inspect + .env) on 2026-09-22.

# --- model / serving ---
MODEL_ID=Qwen/Qwen3.8-Flash-Next-FP8
SERVED_MODEL_NAME=qwen3.8-flash-next-fp8
MAX_MODEL_LEN=262144
YARN_ENABLE=false
PORT=8888

# --- cluster ---
HEAD_IP=192.168.0.231
WORKER_IP=192.168.0.228
IFACE=enp1s0f0np0
IB_HCA==rocep1s0f0
IB_GID_INDEX=3
TENSOR_PARALLEL_SIZE=2
MM_ENCODER_TP_MODE=data

# --- memory / KV (the sweep target knobs) ---
GPU_MEMORY_UTILIZATION=0.70
KV_CACHE_DTYPE=fp8
MAMBA_SSM_CACHE_DTYPE=bfloat16
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
ENABLE_EXPERT_PARALLEL=false
PLE_OFFLOAD=true
PLE_PACKED_TABLE_DIR=/var/tmp/qwen38-ple-packed
SKIP_PLE_PATCH=false
CONTAINER_MEM_GIB=40
MEMWATCH_MIN_GIB=6

# --- speculation ---
MTP_NUM_SPECULATIVE_TOKENS=3
MTP_DRAFT_VOCAB=files/draft_vocab_en_code_47k.txt

# --- weights / launch flags ---
IMAGE=vllm/vllm-openai:qwen38-flash-next
IMAGE_DIGEST=sha256:d464f3b466fa9c45ddbff8a812e80564503b6879a9fd95c1a47514f3f0df5a4a
FP8_DENSE=false
QSA_PROFILE=stock
REQUIRE_IDLE_GPU=true
EVICT_PAGE_CACHE=true
NFS_SHARE=false
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
MASTER_PORT=50000

# --- exact launch command (head node, verbatim from .last_head_launch.sh) ---
# docker run -d --name vllm-fn --gpus all --network host --ipc host \
#   --cap-add SYS_NICE --ulimit memlock=-1 --ulimit stack=67108864 \
#   --memory 40g --memory-swap 40g --device /dev/infiniband:/dev/infiniband \
#   -e GLOO_SOCKET_IFNAME=enp1s0f0np0 -e NCCL_SOCKET_IFNAME=enp1s0f0np0 \
#   -e TP_SOCKET_IFNAME=enp1s0f0np0 -e NCCL_IB_DISABLE=0 -e NCCL_IB_HCA==rocep1s0f0 \
#   -e NCCL_IB_GID_INDEX=3 -e NCCL_IB_AUTO_DETECT=0 -e NCCL_DEBUG=WARN \
#   -e HF_HUB_OFFLINE=1 -e TRANSFORMERS_OFFLINE=1 -e VLLM_HOST_IP=192.168.0.231 \
#   -e VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 -e VLLM_PLE_CPU_OFFLOAD=1 \
#   -e VLLM_PLE_PACKED_TABLE_DIR=/var/tmp/qwen38-ple-packed \
#   -e VLLM_MTP_DRAFT_VOCAB=/etc/vllm-draft-vocab.txt \
#   -v /home/pch/MyProjects/Qwen3.8-Flash-Next-Dual-DGX-Sparks/files/... (patched vLLM files, ro) \
#   -v /var/tmp/qwen38-ple-packed:/var/tmp/qwen38-ple-packed:ro \
#   -v /home/pch/.cache/huggingface:/root/.cache/huggingface \
#   -v /home/pch/.cache/vllm:/root/.cache/vllm \
#   vllm/vllm-openai:qwen38-flash-next \
#   Qwen/Qwen3.8-Flash-Next-FP8 \
#   --served-model-name qwen3.8-flash-next-fp8 --tensor-parallel-size 2 \
#   --gpu-memory-utilization 0.70 --max-num-seqs 8 --max-num-batched-tokens 8192 \
#   --max-model-len 262144 --kv-cache-dtype fp8 --mamba-ssm-cache-dtype bfloat16 \
#   --load-format safetensors --safetensors-load-strategy lazy --enable-chunked-prefill \
#   --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder \
#   --distributed-executor-backend mp --mm-encoder-tp-mode data --nnodes 2 \
#   --master-addr 192.168.0.231 --master-port 50000 \
#   --speculative-config '{"method":"mtp","num_speculative_tokens":3,"use_local_argmax_reduction":true}' \
#   --compilation-config '{"mode":0,"cudagraph_mode":"FULL_DECODE_ONLY"}' \
#   --node-rank 0 --host 0.0.0.0 --port 8888

# --- benchmark protocol (standard, all tune tickets use this) ---
# 1. docker stop vllm-fn on orcus AND warda
# 2. sudo sync && echo 3 | sudo tee /proc/sys/vm/drop_caches on BOTH nodes
# 3. apply param change -> commit tracked profile + result record -> push origin
# 4. ./start-fp8.sh (head) + worker side per repo launch flow
# 5. poll /health on orcus:8888 until 200 (allow ~30 min)
# 6. ssh jupiter.lan: ~/.local/bin/tool-eval-bench --base-url http://orcus.lan:8888/v1
#    (full defaults — no extra flags, comparability rule; model auto-detected)
# 7. compare with: ~/.local/bin/tool-eval-bench --leaderboard
# Success gate: healthy boot + no crash/OOM + score >= leaderboard best at equal-or-higher config.
